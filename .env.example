# Database
MONGODB_URI=mongodb+srv://username:password@cluster0.mongodb.net/a2ruedas_db

# JWT Secrets (genera 32+ caracteres aleatorios para cada una)
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-here
JWT_REFRESH_SECRET=your-super-secret-refresh-key-min-32-chars-here

# SendGrid Email
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here
EMAIL_FROM=noreply@a2ruedas.com
EMAIL_FROM_NAME=A2 Ruedas Outlet

# Mercado Libre Credentials
ML_APP_ID=your_mercadolibre_app_id
ML_CLIENT_SECRET=your_mercadolibre_client_secret

# Environment
NODE_ENV=development
PORT=3001

# Frontend URL (para CORS)
FRONTEND_URL=http://localhost:5173

# Admin user inicial
ADMIN_EMAIL=Mica@motos.com
ADMIN_PASSWORD=change_me_in_production
ADMIN_NAME=Mica Admin

